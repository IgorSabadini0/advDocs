# Configuração do Servidor
PORT_SERVER=3000
HOST_SERVER=localhost
MESSAGE_SERVER="Servidor rodando na porta"
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=advdocs_user
DB_PASSWORD=substitua_por_senha_segura
DB_NAME=advdocs

# Autenticação JWT (mínimo 32 caracteres aleatórios)
JWT_SECRET=substitua_por_chave_jwt_aleatoria_com_mais_de_32_caracteres

# Integração CNJ / DataJud (opcional)
DATAJUD_API_KEY=

# Web Push API (RFC 8030 / VAPID) - gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@palharesferreiraadvocacia.com.br
